##multi year raster viewer
library(terra)
years<-1951:1956
annual_result<-list() ##sote annual raster for each selected year
for (year_index in seq_along(years)) {
year<-years[year_index]
nc_path <- paste0("C:/Hydrology-Project/Rainfall Trend/NCDF/Daily_nc_", year, ".nc")
##check whether file is exist or not
if(file.exists(nc_path)){
##load the raster file for each year
r<-rast(nc_path)
## calculate annual precipitation sum for each year
annual_sum <- app(r, na.rm = TRUE)
## store in list
annual_list[[as.character(year)]] <- annual_sum
}
}
