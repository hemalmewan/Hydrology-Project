##Remove ID column
rain_values<-rain_values[,-1]
##define the function for each seasonal pattern
annual<-function(daily_data){
mean<-mean(daily_data,na.rm=TRUE)
min<-min(daily_data,na.rm = TRUE)
max<-max(daily_data,na.rm = TRUE)
sd<-sd(daily_data,na.rm = TRUE)
skewness<-skewness(daily_data,na.rm = TRUE)
kurtosis<-kurtosis(daily_data,na.rm = TRUE)
return(c(mean,min,max,sd,skewness,kurtosis))
}
stat_vals<-apply(rain_values,1,annual)
stat_vals
stat_vals[1]
stat_vals[1,1]
stat_vals[,1]
