print(dbGetQuery(con,"SELECT * FROM Daily_precipitation_1951 LIMIT 5"))
print(dbGetQuery(con,"SELECT * FROM Daily_precipitation_1951 LIMIT 5"))
print(dbGetQuery(con,"SELECT * FROM daily_precipitation_1951 LIMIT 5"))
print(dbGetQuery(con,"SELECT * FROM 'Daily_precipitation_1951' LIMIT 5"))
print(dbGetQuery(con,SELECT * FROM "Daily_precipitation_1951" LIMIT 5;))
print(dbGetQuery(con,'SELECT * FROM "Daily_precipitation_1951" LIMIT 5;'))
print(dbGetQuery(con,'SELECT * FROM "Daily_precipitation_1951" LIMIT 10;'))
print(dbGetQuery(con,'SELECT * FROM "Daily_precipitation_1951" LIMIT 10;'))
