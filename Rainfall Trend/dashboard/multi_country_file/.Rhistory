library(terra)
# 1. Define folder and list files
folder <- "C:/Hydrology-Project/PCP_data_ghana_ethi/PCP_ethi/1981/"
files <- list.files(folder, pattern = "\\.tif$", full.names = TRUE)
# Sort files to ensure Day 1 comes before Day 2
# (Extract numbers to avoid 1, 10, 100 sorting issues)
day_nums <- as.numeric(gsub(".*day_([0-9]+)\\.tif", "\\1", basename(files)))
files <- files[order(day_nums)]
# 2. Load all layers initially (Result: 730 layers)
r_temp <- rast(files)
r_temp
# 3. FIX: SUBSET TO KEEP ONLY BAND 1
# Keep odd layers (1, 3, 5...) to drop the metadata band
indices <- seq(1, nlyr(r_temp), by = 2)
r_final <- r_temp[[indices]]
r_final
# 4. Define the output path
out_nc <- "C:/Hydrology-Project/Rainfall Trend/NCDF/ethiopia"
# Ensure the directory actually exists before writing
dir_path <- dirname(out_nc)
if (!dir.exists(dir_path)) {
dir.create(dir_path, recursive = TRUE)
}
# 4. Define the output path
out_nc <- "C:/Hydrology-Project/Rainfall Trend/NCDF/ethiopia/Daily_nc_1981.nc"
# Ensure the directory actually exists before writing
dir_path <- dirname(out_nc)
if (!dir.exists(dir_path)) {
dir.create(dir_path, recursive = TRUE)
}
# 5. Define Dates
dates <- seq(as.Date("1981-01-01"), as.Date("1981-12-31"), by="day")
# 6. Write NetCDF (Pass 'time' HERE instead of modifying r_final)
writeCDF(r_final,
filename = out_nc,
overwrite = TRUE,
varname = "precip",
unit = "mm",
longname = "Daily precipitation",
compression = 4,
time = dates)  # <--- This is the fix!
dates
