max = rng["max"])
server <- function(input, output, session) {
# --- Define Year Ranges ---
country_ranges <- list(
"India"    = c(min = 1951, max = 2007),
"Ghana"    = c(min = 1981, max = 2024),
"Ethiopia" = c(min = 1981, max = 2024)
)
# --- Observer: Update Inputs when Country Changes ---
observeEvent(input$country, {
req(input$country)
# 1. Get the specific range
rng <- country_ranges[[input$country]]
# 2. Update the Sidebar Year Input
# We reset the default value to the start year to ensure it's valid
updateNumericInput(session, "year",
value = rng["min"],
min = rng["min"],
max = rng["max"])
# 3. Update the Multi-Year Slider
# We set a default range of the first 5 years
updateSliderInput(session, "year_range",
min = rng["min"],
max = rng["max"],
value = c(rng["min"], rng["min"] + 5))
})
# ... (The rest of your server code goes here) ...
}
