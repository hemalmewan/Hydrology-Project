library(terra)
# 1. Define folder and list files (as you did before)
folder <- "C:/Hydrology-Project/PCP_data_ghana_ethi/PCP_ethi/1981/"
files <- list.files(folder, pattern = "\\.tif$", full.names = TRUE)
# 2. Load all layers initially (this gives you the 730 layers)
r_temp <- rast(files)
# 3. --- FIX: SUBSET TO KEEP ONLY BAND 1 ---
# We want layers 1, 3, 5, 7... (the first layer of each file)
# We do NOT want layers 2, 4, 6, 8... (the second layer of each file)
indices <- seq(1, nlyr(r_temp), by = 2) # Create a sequence: 1, 3, 5, ...
r_final <- r_temp[[indices]]            # Subset the raster
# Assign time to the cleaned object
dates <- seq(as.Date("1981-01-01"), as.Date("1981-12-31"), by="day")
time(r_final) <- dates
